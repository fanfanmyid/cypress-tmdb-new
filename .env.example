# TMDB E2E credentials — dummy placeholders only. Never commit real values.
#
# Option A (recommended): export these in your shell before running Cypress.
# Cypress automatically maps any CYPRESS_* environment variable into Cypress.env()
# (e.g. CYPRESS_PRIMARY_USER -> Cypress.env('PRIMARY_USER')).
#
# Option B: copy the JSON block below into cypress.env.json at the repo root
# (git-ignored). Option C: cypress/fixtures/simplidots_tmdb/users.local.json
# (also git-ignored). Precedence: env vars > users.local.json > users.json.
#
# primary    = valid account (used by Auth-Login#1, #5, #6)
# secondary  = valid username + wrong password (Auth-Login#2)
# tertiary   = wrong username + valid password (Auth-Login#3)
# quaternary = wrong username + wrong password (Auth-Login#4)

CYPRESS_PRIMARY_USER=dummy-valid-username
CYPRESS_PRIMARY_USER_PW=dummy-valid-password
CYPRESS_SECONDARY_USER=dummy-valid-username
CYPRESS_SECONDARY_USER_PW=dummy-wrong-password
CYPRESS_TERTIARY_USER=dummy-invalid-username
CYPRESS_TERTIARY_USER_PW=dummy-valid-password
CYPRESS_QUATERNARY_USER=dummy-invalid-username
CYPRESS_QUATERNARY_USER_PW=dummy-wrong-password

# cypress.env.json equivalent:
# {
#   "PRIMARY_USER": "your-tmdb-username",
#   "PRIMARY_USER_PW": "your-tmdb-password",
#   "SECONDARY_USER": "your-tmdb-username",
#   "SECONDARY_USER_PW": "definitely-wrong-password",
#   "TERTIARY_USER": "no-such-tmdb-user",
#   "TERTIARY_USER_PW": "your-tmdb-password",
#   "QUATERNARY_USER": "no-such-tmdb-user",
#   "QUATERNARY_USER_PW": "definitely-wrong-password"
# }